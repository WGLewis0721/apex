# Copy to .env.local for local development (npm run dev / vite reads this
# automatically). .env* files are gitignored except this example.

# --- Frontend (bundled into the browser build; safe to expose) ---------
# From your Supabase project's API settings. The anon key is only ever as
# powerful as the RLS policies in supabase/migrations allow.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# When the two vars above are unset, the app falls back to the original
# fully-simulated onboarding flow (no backend calls at all) — nothing
# breaks, it just isn't real.

# --- Backend only: Supabase Edge Function secrets, never in this file ---
# Set these with `supabase secrets set NAME=value`, never as VITE_* vars,
# never committed anywhere. Listed here only for reference:
#
#   SUPABASE_URL                (auto-provided to Edge Functions)
#   SUPABASE_ANON_KEY           (auto-provided to Edge Functions)
#   SUPABASE_SERVICE_ROLE_KEY   (auto-provided to Edge Functions)
#   STRIPE_SECRET_KEY           sk_test_... or sk_live_...
#   STRIPE_WEBHOOK_SECRET       whsec_... (from `stripe listen` or the
#                               webhook endpoint's settings page)

# --- Operator script only (scripts/stripe-setup.mjs), run locally, once -
#   STRIPE_SECRET_KEY=sk_test_... node scripts/stripe-setup.mjs
