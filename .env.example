# Copy to .env.local for local development (npm run dev / vite reads this
# automatically). .env* files are gitignored except this example.

# --- Frontend (bundled into the browser build; safe to expose) ---------
# From your Supabase project's API settings (Settings > API Keys > the
# "Publishable key" under the new sb_publishable_... format). This is not
# a secret: it is only ever as powerful as the RLS policies in
# supabase/migrations allow.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# When the two vars above are unset, the app falls back to the original
# fully-simulated onboarding flow (no backend calls at all) — nothing
# breaks, it just isn't real.

# --- Beta waitlist → Google Sheets (docs/WAITLIST_API.md) -------------------
# Server-side only: Supabase function secrets for apex-waitlist, not Vite vars. Never expose these to the browser.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The JSON key's private_key, with literal \n line breaks.
GOOGLE_PRIVATE_KEY=
# The ID between /d/ and /edit in the waitlist sheet URL.
WAITLIST_SPREADSHEET_ID=
# Optional: tab name (empty = first tab); extra comma-separated browser origins.
WAITLIST_SHEET_TAB=
WAITLIST_ALLOWED_ORIGINS=
# New-signup email alerts go to graymattertechllc@gmail.com via FormSubmit by default.
# Set another address, FormSubmit's alias after activation, or "off".
WAITLIST_NOTIFY_EMAIL=
